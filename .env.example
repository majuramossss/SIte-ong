# Dummy placeholders only. Copy privately to .env for local use.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
SECRET_KEY=REPLACE_WITH_A_RANDOM_STABLE_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=1
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD
# Render supplies RENDER=true automatically. Local HTTP requires COOKIE_SECURE=0.